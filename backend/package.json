{
  "name": "discord-clone-backend",
  "version": "1.0.0",
  "description": "Backend for Discord clone",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down && docker volume rm backend_postgres_data backend_redis_data && docker-compose up -d"
  },
  "dependencies": {
    "bcryptjs": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.0.0",
    "pg-hstore": "^2.3.0",
    "redis": "^4.0.0",
    "sequelize": "^6.0.0",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
